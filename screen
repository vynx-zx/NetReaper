// FIX: responsiveDelay now updates display immediately on stop + every 500ms during attack
void responsiveDelay(int ms){
  unsigned long s=millis();
  static unsigned long lastDisp=0;
  while(millis()-s<ms){
    checkButtons();
    if(appState!=STATE_DEAUTH_ATTACK){
      updateDisplay(); // IMMEDIATE display update when button pressed
      return;
    }
    if(millis()-lastDisp>500){
      updateDisplay(); // Live update every 500ms during attack
      lastDisp=millis();
    }
    delay(10);
  }
}

