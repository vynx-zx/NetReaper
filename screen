void loop(){
  checkButtons();
  if(isJamming&&appState!=STATE_RF_JAM){appState=STATE_RF_JAM;currentMode=MODE_RF_JAM;}
  if(isDeauthing&&appState!=STATE_DEAUTH_ATTACK){appState=STATE_DEAUTH_ATTACK;currentMode=MODE_DEAUTH;}
  if(isBeaconing&&appState!=STATE_BEACON){appState=STATE_BEACON;currentMode=MODE_BEACON;}
  if(!isJamming&&!isDeauthing&&!isBeaconing&&(appState==STATE_RF_JAM||appState==STATE_DEAUTH_ATTACK||appState==STATE_BEACON)){appState=STATE_MENU;}
  updateLEDs();
  switch(appState){
    case STATE_RF_JAM:aggressiveRandomMode();server.handleClient();break;
    case STATE_DEAUTH_ATTACK:server.handleClient();sendPowerfulDeauth();delay(1);yield();break;
    case STATE_BEACON:
      server.handleClient();esp_wifi_set_channel(currentBeaconChannel,WIFI_SECOND_CHAN_NONE);
      for(int i=0;i<30;i++)sendBeacon(currentBeaconChannel);
      currentBeaconChannel++;if(currentBeaconChannel>13)currentBeaconChannel=1;yield();break;
    default:server.handleClient();handleSerial();break;
  }
  updateDisplay();
}
