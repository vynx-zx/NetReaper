void handleScan(){if(isJamming){isJamming=false;stopJamming();}if(isBeaconing)stopBeaconFlood();startWiFiScan();server.sendHeader("Location","/",true);server.send(302);}
void handleDeauth(){
  String i=server.arg("idx");
  if(i=="stop"){stopDeauth();appState=(networkCount>0)?STATE_DEAUTH_LIST:STATE_MENU;}
  else{int x=i.toInt();if(isJamming){isJamming=false;stopJamming();}if(isBeaconing)stopBeaconFlood();startDeauth(x);appState=STATE_DEAUTH_ATTACK;currentMode=MODE_DEAUTH;}
  server.sendHeader("Location","/",true);server.send(302);
}
void handleBeacon(){
  String a=server.arg("action");
  if(a=="start"){startBeaconFlood();appState=STATE_BEACON;currentMode=MODE_BEACON;}
  else{stopBeaconFlood();appState=STATE_MENU;}
  server.sendHeader("Location","/",true);server.send(302);
}
void handleRFToggle(){
  String t=server.arg("time");int s=t.toInt();
  if(s>=0){if(isDeauthing)stopDeauth();if(isBeaconing)stopBeaconFlood();isJamming=true;startJamming();appState=STATE_RF_JAM;currentMode=MODE_RF_JAM;isWebRfJamming=false;}
  server.send(200,"text/plain","OK");
}
void handleSerial(){
  if(Serial.available()){
    String c=Serial.readStringUntil('\n');c.trim();
    if(c.equalsIgnoreCase("scan"))startWiFiScan();
    else if(c.startsWith("deauth ")){String a=c.substring(7);if(a=="off")stopDeauth();else startDeauth(a.toInt());}
    else if(c.equalsIgnoreCase("rf")){if(isJamming){isJamming=false;stopJamming();appState=STATE_MENU;}else{isJamming=true;startJamming();appState=STATE_RF_JAM;currentMode=MODE_RF_JAM;}}
    else if(c.equalsIgnoreCase("beacon")){if(isBeaconing)stopBeaconFlood();else{startBeaconFlood();appState=STATE_BEACON;currentMode=MODE_BEACON;}}
  }
}

