void updateLEDs(){
  static unsigned long lb=0;static bool bs=false;
  bool active=(appState==STATE_RF_JAM||appState==STATE_DEAUTH_ATTACK||appState==STATE_BEACON);
  if(active&&millis()-lb>200){
    bs=!bs;lb=millis();
    if(appState==STATE_RF_JAM)digitalWrite(rfLedPin,bs?HIGH:LOW);
    if(appState==STATE_DEAUTH_ATTACK||appState==STATE_BEACON)digitalWrite(deauthLedPin,bs?HIGH:LOW);
  }
  if(!active){digitalWrite(rfLedPin,LOW);digitalWrite(deauthLedPin,LOW);}
}

void handleScroll(){
  switch(appState){
    case STATE_MENU:currentMode=(currentMode+1)%MODE_COUNT;break;
    case STATE_DEAUTH_LIST:
      selectedNetwork=(selectedNetwork+1)%(networkCount+2);break; // +2 for Rescan+Back
    case STATE_SCAN_RESULTS:
      scrollOffset=(scrollOffset+1)%(networkCount+2);break;
    default:stopCurrentMode();break;
  }
}
void handleSelect(){
  switch(appState){
    case STATE_MENU:enterMode(currentMode);break;
    case STATE_DEAUTH_LIST:
      if(selectedNetwork<networkCount){
        startDeauth(selectedNetwork);
        appState=STATE_DEAUTH_ATTACK;
      }else if(selectedNetwork==networkCount){
        // Rescan
        appState=STATE_DEAUTH_SCAN;
        updateDisplay();
        startWiFiScan();
        selectedNetwork=0;
        appState=STATE_DEAUTH_LIST;
      }else{
        // Back
        appState=STATE_MENU;
      }
      break;
    case STATE_SCAN_RESULTS:
      if(scrollOffset==networkCount){
        // Rescan
        appState=STATE_SCAN;
        updateDisplay();
        startWiFiScan();
        scrollOffset=0;
        appState=STATE_SCAN_RESULTS;
      }else{
        // Back (or any network selected)
        appState=STATE_MENU;
      }
      break;
    default:stopCurrentMode();break;
  }
}

// ==========================================================================
// FIX: GPIO5 too sensitive — now requires DOUBLE-READ confirmation
//   (read → 10ms wait → read again, both must be LOW) + 500ms debounce +
//   150ms cross-guard (won't fire if GPIO4 was pressed <150ms ago).
//   GPIO4 also gets double-read for consistency, keeps 300ms debounce.
// ==========================================================================
void checkButtons(){
  static int l4=HIGH,l5=HIGH;
  static unsigned long t4=0,t5=0;
  int b4=digitalRead(btnScrollPin);
  int b5=digitalRead(btnSelectPin);
  unsigned long now=millis();

  // GPIO4 (Scroll) — 300ms debounce + double-read confirm
  if(b4==LOW&&l4==HIGH&&(now-t4)>300){
    delay(10);
    if(digitalRead(btnScrollPin)==LOW){
      t4=now;
      handleScroll();
    }
  }

  // GPIO5 (Select) — 500ms debounce + 150ms cross-guard + double-read confirm
  if(b5==LOW&&l5==HIGH&&(now-t5)>500&&(now-t4)>150){
    delay(10);
    if(digitalRead(btnSelectPin)==LOW){
      t5=now;
      handleSelect();
    }
  }

  l4=b4;
  l5=b5;
}

void enterMode(int mode){
  switch(mode){
    case MODE_RF_JAM:
      isJamming=true;startJamming();appState=STATE_RF_JAM;break;
    case MODE_DEAUTH:
      if(!scanExecuted){
        appState=STATE_DEAUTH_SCAN;
        updateDisplay();
        startWiFiScan();
      }
      selectedNetwork=0;
      appState=STATE_DEAUTH_LIST;
      break;
    case MODE_BEACON:
      startBeaconFlood();appState=STATE_BEACON;break;
    case MODE_SCAN:
      appState=STATE_SCAN;
      updateDisplay();
      startWiFiScan();
      scrollOffset=0;
      appState=STATE_SCAN_RESULTS;
      break;
  }
}

void stopCurrentMode(){
  if(appState==STATE_RF_JAM){isJamming=false;stopJamming();appState=STATE_MENU;}
  else if(appState==STATE_DEAUTH_ATTACK){
    stopDeauth();
    appState=(networkCount>0)?STATE_DEAUTH_LIST:STATE_MENU;
  }
  else if(appState==STATE_BEACON){stopBeaconFlood();appState=STATE_MENU;}
  digitalWrite(rfLedPin,LOW);
  digitalWrite(deauthLedPin,LOW);
}

