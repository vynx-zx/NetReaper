String getVendorName(uint8_t* m){
  char p[9];sprintf(p,"%02X:%02X:%02X",m[0],m[1],m[2]);String s=String(p);
  if(s.startsWith("00:1A:11")||s.startsWith("00:1B:63")||s.startsWith("00:25:00")||s.startsWith("00:26:BB")||s.startsWith("00:50:E4")||s.startsWith("DC:A6:32")||s.startsWith("F0:18:E3")||s.startsWith("3C:22:FB")||s.startsWith("A0:18:E3"))return "Apple";
  if(s.startsWith("00:12:FB")||s.startsWith("00:15:99")||s.startsWith("00:1B:4B")||s.startsWith("00:1D:F6")||s.startsWith("00:21:19")||s.startsWith("5C:0A:5B"))return "Samsung";
  if(s.startsWith("8C:77:12")||s.startsWith("4C:66:41")||s.startsWith("0C:1D:AF")||s.startsWith("00:08:22")||s.startsWith("00:15:AF"))return "Xiaomi";
  if(s.startsWith("00:0C:43")||s.startsWith("00:11:24")||s.startsWith("00:16:B6")||s.startsWith("00:18:3F")||s.startsWith("00:1A:73"))return "OnePlus";
  if(s.startsWith("F8:8A:5E")||s.startsWith("E0:B5:5F"))return "Google";
  if(s.startsWith("B8:27:EB"))return "R-Pi";
  if(s.startsWith("24:0A:64")||s.startsWith("3C:71:37"))return "ESP";
  return "Unknown";
}
bool isPMFRequired(int e){return(e==WIFI_AUTH_WPA3_PSK||e==WIFI_AUTH_WPA2_WPA3_PSK);}
String getEncName(int e){switch(e){case 0:return "OPEN";case 1:return "WEP";case 2:return "WPA";case 3:return "WPA2";case 4:return "WPA/WPA2";case 5:return "WPA2-ENT";case 6:return "WPA3!";case 7:return "WPA2/WPA3!";default:return "ENC"+String(e);}}

int getClientCountForNetwork(int idx){
  int c=0;
  for(int j=0;j<globalSniffedCount;j++)
    if(memcmp(scannedNetworks[idx].bssid,globalSniffedClients[j].bssid,6)==0)c++;
  return c;
}

