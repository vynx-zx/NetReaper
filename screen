  radio.setAutoAck(false);radio.stopListening();radio.setRetries(0,0);
  radio.setPALevel(RF24_PA_MAX,true);radio.setDataRate(RF24_2MBPS);radio.setCRCLength(RF24_CRC_DISABLED);
  radio1.setAutoAck(false);radio1.stopListening();radio1.setRetries(0,0);
  radio1.setPALevel(RF24_PA_MAX,true);radio1.setDataRate(RF24_2MBPS);radio1.setCRCLength(RF24_CRC_DISABLED);
}
void initSP(){sp=new SPIClass(VSPI);sp->begin(18,19,23,21);if(radio1.begin(sp)){initRF24Configs();radio1.powerDown();}}
