void checkDeauthButton(){
  static int l=HIGH;static unsigned long lt=0,lpt=0;
  int cs=digitalRead(deauthButtonPin);
  if(cs==LOW&&l==HIGH){
    if(millis()-lt>300){
      lt=millis();
      if(millis()-lpt<400){
        if(isBeaconing)stopBeaconFlood();
        else{
          if(isJamming){stopJamming();isJamming=false;}
          if(isDeauthing)stopDeauth();
          startBeaconFlood();
        }
        lpt=0;
      } else lpt=millis();
    }
  }
  if(lpt!=0&&millis()-lpt>400&&cs==HIGH){
    if(!isBeaconing){
      if(!isDeauthing){
        if(isJamming){stopJamming();isJamming=false;}
        WiFi.mode(WIFI_OFF);delay(200);
        WiFi.mode(WIFI_AP);delay(100);
        if(!scanExecuted){startWiFiScan();if(networkCount>0)startDeauth(0);}
        else if(networkCount>0) startDeauth(0);
      } else stopDeauth();
    }
    lpt=0;
  }
  l=cs;
}

