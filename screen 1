bool isPMFRequired(int e){return(e==WIFI_AUTH_WPA3_PSK||e==WIFI_AUTH_WPA2_WPA3_PSK);}
String getEncName(int e){switch(e){case 0:return "OPEN";case 1:return "WEP";case 2:return "WPA";case 3:return "WPA2";case 4:return "WPA/WPA2";case 5:return "WPA2-ENT";case 6:return "WPA3!";case 7:return "WPA2/WPA3!";default:return "ENC"+String(e);}}

int getClientCountForNetwork(int idx){
  int c=0;
  for(int j=0;j<globalSniffedCount;j++)
    if(memcmp(scannedNetworks[idx].bssid,globalSniffedClients[j].bssid,6)==0)c++;
  return c;
}

void responsiveDelay(int ms){
  unsigned long s=millis();
  static unsigned long lastDisp=0;
  while(millis()-s<ms){
    checkButtons();
    if(appState!=STATE_DEAUTH_ATTACK)return;
    if(millis()-lastDisp>200){updateDisplay(); lastDisp=millis();}
    delay(10);
  }
}

