void loop() {
  checkDeauthButton();
  checkJammerButton();
  
  if (isBeaconing) {
    server.handleClient();
    handleSerial();
    esp_wifi_set_channel(currentBeaconChannel, WIFI_SECOND_CHAN_NONE);
    for (int i = 0; i < 30; i++) {
      sendBeacon(currentBeaconChannel);
    }
    currentBeaconChannel++;
    if (currentBeaconChannel > 13) currentBeaconChannel = 1;
    yield();
  } 
  else if (isJamming) {
    checkJammerButton();
    if (isWebRfJamming && (millis() - rfJamStartTime >= currentWebJamDuration)) {
      isJamming = false;
      stopJamming();
    } else {
      aggressiveRandomMode();
    }
  } 
  else {
    server.handleClient();
    handleSerial();
    checkJammerButton(); 
    checkDeauthButton(); 

    if (isDeauthing) { 
      sendPowerfulDeauth(); 
      delay(1); 
      yield(); 
    }
  }
}
