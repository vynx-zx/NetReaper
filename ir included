// ============ IR SETUP ============
void setupIR() {
  ledcSetup(irChannel, irFreq, 8);
  ledcAttachPin(irPin, irChannel);
  ledcWrite(irChannel, 0);
}

void irMark(int us) {
  ledcWrite(irChannel, 128);
  delayMicroseconds(us);
}

void irSpace(int us) {
  ledcWrite(irChannel, 0);
  delayMicroseconds(us);
}

// ============ NEC PROTOCOL ============
void sendNEC(uint32_t code) {
  irMark(9000);
  irSpace(4500);
  for (int i = 31; i >= 0; i--) {
    irMark(560);
    if ((code >> i) & 1) irSpace(1690);
    else irSpace(560);
  }
  irMark(560);
  irSpace(5000);
}

// ============ SONY SIRC PROTOCOL ============
void sendSony(uint32_t code, int bits) {
  irMark(2400);
  irSpace(600);
  for (int i = 0; i < bits; i++) {
    if ((code >> i) & 1) irMark(1200);
    else irMark(600);
    irSpace(600);
  }
  irSpace(25000);
}

// ============ RC5 PROTOCOL ============
void sendRC5(uint8_t address, uint8_t command) {
  uint16_t frame = (0b11 << 12) | (0 << 11) | ((address & 0x1F) << 6) | (command & 0x3F);
  for (int i = 13; i >= 0; i--) {
    bool bit = (frame >> i) & 1;
    if (bit == 1) { irMark(889); irSpace(889); }
    else { irSpace(889); irMark(889); }
  }
  irSpace(889);
}

void startIRJam() {
  if (isJamming) { isJamming = false; stopJamming(); }
  if (isDeauthing) stopDeauth();
  if (isBeaconing) stopBeaconFlood();
  setupIR();
  isIRJamming = true;
  digitalWrite(rfLedPin, HIGH);
  digitalWrite(deauthLedPin, HIGH);
  Serial.println("[*] MULTI-PROTOCOL IR SHUTOFF - NEC + Sony + RC5 (TVs+ACs+Fans+STBs)");
}

void stopIRJam() {
  isIRJamming = false;
  ledcWrite(irChannel, 0);
  ledcDetachPin(irPin);
  digitalWrite(rfLedPin, LOW);
  digitalWrite(deauthLedPin, LOW);
  Serial.println("[*] IR Flood Stopped");
}

void aggressiveIRFlood() {
  for (int i = 0; i < NEC_COUNT; i++) { sendNEC(NEC_OFF[i]); if (!isIRJamming) return; }
