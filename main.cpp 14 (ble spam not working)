void handleScan(){if(isJamming)stopJamming();if(isBeaconing)stopBeaconFlood();if(isBTSpamming)stopBTSpamMode();server.send(200,"text/html","<html><head><meta http-equiv='refresh' content='4;url=/'></head><body style='background:#0a0a0a;color:#ffaa00;font-family:monospace;text-align:center;padding:40px;'><h1>SCANNING...</h1></body></html>");startWiFiScan();}
void handleDeauth(){String i=server.arg("idx");if(i=="stop")stopDeauth();else{int x=i.toInt();if(isJamming){stopJamming();isJamming=false;}if(isBeaconing)stopBeaconFlood();if(isBTSpamming)stopBTSpamMode();startDeauth(x);}server.sendHeader("Location","/",true);server.send(302);}
void handleBeacon(){String a=server.arg("action");if(a=="start"){if(isJamming){stopJamming();isJamming=false;}if(isDeauthing)stopDeauth();if(isBTSpamming)stopBTSpamMode();startBeaconFlood();}else stopBeaconFlood();server.sendHeader("Location","/",true);server.send(302);}
void handleRFToggle(){String t=server.arg("time");int s=t.toInt();if(s>=0){if(isDeauthing)stopDeauth();if(isBeaconing)stopBeaconFlood();if(isBTSpamming)stopBTSpamMode();isJamming=true;startJamming();if(s>0){isWebRfJamming=true;currentWebJamDuration=s*1000;rfJamStartTime=millis();}else isWebRfJamming=false;}server.send(200,"text/plain","OK");}
void handleSerial(){if(Serial.available()){String c=Serial.readStringUntil('\n');c.trim();if(c.equalsIgnoreCase("scan")){if(isJamming)stopJamming();if(isBeaconing)stopBeaconFlood();if(isBTSpamming)stopBTSpamMode();startWiFiScan();}else if(c.startsWith("deauth ")){String a=c.substring(7);if(a=="off")stopDeauth();else{if(isJamming)stopJamming();if(isBeaconing)stopBeaconFlood();if(isBTSpamming)stopBTSpamMode();startDeauth(a.toInt());}}else if(c.equalsIgnoreCase("rf"))toggleJammerPhysical();else if(c.equalsIgnoreCase("beacon")){if(isBeaconing)stopBeaconFlood();else startBeaconFlood();}else if(c.equalsIgnoreCase("btspam")){if(isBTSpamming)stopBTSpamMode();else startBTSpamMode();}}}

