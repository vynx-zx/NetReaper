void startBeaconFlood(){if(isJamming){isJamming=false;stopJamming();}if(isDeauthing)stopDeauth();if(isBTSpamming)stopBTSpamMode();isBeaconing=true;digitalWrite(rfLedPin,HIGH);digitalWrite(deauthLedPin,HIGH);esp_wifi_set_max_tx_power(84);WiFi.mode(WIFI_AP);delay(50);esp_wifi_set_promiscuous(true);currentBeaconChannel=1;}
void stopBeaconFlood(){isBeaconing=false;digitalWrite(rfLedPin,LOW);digitalWrite(deauthLedPin,LOW);esp_wifi_set_promiscuous(false);WiFi.mode(WIFI_AP);delay(50);}
void sendBeacon(int channel){uint8_t b[6];for(int i=0;i<6;i++)b[i]=esp_random()%256;b[0]&=0xFE;char s[32];snprintf(s,sizeof(s),"rajdeep_%04d",(esp_random()%9000)+1000);int sl=strlen(s);
  beaconPacket[0]=0x80;beaconPacket[1]=0;beaconPacket[2]=0;beaconPacket[3]=0;memset(&beaconPacket[4],0xFF,6);memcpy(&beaconPacket[10],b,6);memcpy(&beaconPacket[16],b,6);beaconPacket[22]=esp_random()%256;beaconPacket[23]=(esp_random()%256)&0xF0;
  uint64_t ts=esp_timer_get_time();memcpy(&beaconPacket[24],&ts,8);beaconPacket[32]=0x64;beaconPacket[33]=0;beaconPacket[34]=0x11;beaconPacket[35]=0x04;int o=36;
  beaconPacket[o++]=0;beaconPacket[o++]=sl;memcpy(&beaconPacket[o],s,sl);o+=sl;
  beaconPacket[o++]=0x01;beaconPacket[o++]=0x0C;beaconPacket[o++]=0x82;beaconPacket[o++]=0x84;beaconPacket[o++]=0x8B;beaconPacket[o++]=0x96;beaconPacket[o++]=0x0C;beaconPacket[o++]=0x12;beaconPacket[o++]=0x18;beaconPacket[o++]=0x24;beaconPacket[o++]=0x30;beaconPacket[o++]=0x48;beaconPacket[o++]=0x60;beaconPacket[o++]=0x6C;
  beaconPacket[o++]=0x03;beaconPacket[o++]=0x01;beaconPacket[o++]=channel;beaconPacket[o++]=0x2A;beaconPacket[o++]=0x01;beaconPacket[o++]=0;beaconPacket[o++]=0x32;beaconPacket[o++]=4;beaconPacket[o++]=0x6C;beaconPacket[o++]=0x6C;beaconPacket[o++]=0x6C;beaconPacket[o++]=0x6C;
  esp_wifi_80211_tx(WIFI_IF_AP,beaconPacket,o,false);}

